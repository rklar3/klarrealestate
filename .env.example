# Canonical domain, used in metadata, sitemap, and JSON-LD. No trailing slash.
NEXT_PUBLIC_SITE_URL=https://www.klarrealestate.ca

# Resend API key for lead emails. Without it, submissions are logged but not emailed.
RESEND_API_KEY=
# Verified "from" address for lead emails (optional).
LEAD_FROM_EMAIL=

# Google Analytics 4 measurement ID (optional).
NEXT_PUBLIC_GA_ID=

# CREA DDF® Web API credentials — the data feed "username" and "password" from
# the CREA DDF® Team email. Server-only; never prefix with NEXT_PUBLIC_.
# Without them, the listings pages render empty.
DDF_CLIENT_ID=
DDF_CLIENT_SECRET=

# Google Places API (New) key for Google reviews. Server-only. Restrict it to
# "Places API (New)" and to the site's URLs (Websites), e.g. https://klarrealestate.vercel.app/*
GOOGLE_PLACES_API_KEY=
